--!strict

local ServerScriptService = game:GetService("ServerScriptService")
local MovementHistory = require(ServerScriptService.Server.Domain.Combat.MovementHistory)

return function()
	describe("MovementHistory", function()
		local player = {} :: any

		it("requires sampled travel as well as velocity for a running action", function()
			local history = MovementHistory.new()
			history:Observe(player, Vector3.zero, 10)
			expect(history:IsRunning(player, Vector3.new(20, 0, 0), 10)).to.equal(false)
			history:Observe(player, Vector3.new(4, 0, 0), 10.2)
			expect(history:IsRunning(player, Vector3.new(20, 0, 0), 10.2)).to.equal(true)
			expect(history:IsRunning(player, Vector3.new(100, 0, 0), 10.2)).to.equal(false)
			history:Destroy()
		end)

		it("does not accept a teleport destination after the lock expires", function()
			local history = MovementHistory.new()
			history:Observe(player, Vector3.zero, 10)
			expect(history:Observe(player, Vector3.new(100, 0, 0), 10.2)).to.equal(Vector3.zero)
			expect(history:IsPlausible(player, 10.2)).to.equal(false)
			expect(history:Observe(player, Vector3.new(101, 0, 0), 11.3)).to.equal(Vector3.zero)
			expect(history:IsPlausible(player, 11.3)).to.equal(false)
			history:Observe(player, Vector3.new(1, 0, 0), 11.4)
			history:Observe(player, Vector3.new(2, 0, 0), 12.5)
			expect(history:IsPlausible(player, 12.5)).to.equal(true)
			history:Destroy()
		end)

		it("rejects sustained travel that spends the slack on every sample", function()
			local history = MovementHistory.new()
			history:Observe(player, Vector3.zero, 10)
			history:Observe(player, Vector3.new(8, 0, 0), 10.11)
			expect(history:IsPlausible(player, 10.11)).to.equal(true)
			expect(history:Observe(player, Vector3.new(16, 0, 0), 10.22)).to.equal(
				Vector3.new(8, 0, 0)
			)
			expect(history:IsPlausible(player, 10.22)).to.equal(false)
			history:Destroy()
		end)

		it("detects a jump on an action between regular samples", function()
			local history = MovementHistory.new()
			history:Observe(player, Vector3.zero, 10)
			history:Observe(player, Vector3.new(80, 0, 0), 10.01)
			expect(history:IsPlausible(player, 10.01)).to.equal(false)
			history:Destroy()
		end)

		it("blocks vertical teleports while allowing ordinary jumping and falling", function()
			local history = MovementHistory.new()
			history:Observe(player, Vector3.zero, 10)
			history:Observe(player, Vector3.new(0, 5, 0), 10.1)
			expect(history:IsPlausible(player, 10.1)).to.equal(true)
			history:Observe(player, Vector3.new(0, -10, 0), 10.2)
			expect(history:IsPlausible(player, 10.2)).to.equal(true)
			history:Observe(player, Vector3.new(0, 100, 0), 10.21)
			expect(history:IsPlausible(player, 10.21)).to.equal(false)
			history:Destroy()

			local descent = MovementHistory.new()
			descent:Observe(player, Vector3.zero, 20)
			descent:Observe(player, Vector3.new(0, -100, 0), 20.01)
			expect(descent:IsPlausible(player, 20.01)).to.equal(false)
			descent:Destroy()
		end)
	end)
end
